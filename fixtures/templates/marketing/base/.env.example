# Public build-time origins. Set complete URLs; never derive one from the other.
PUBLIC_MARKETING_URL=http://localhost:4321
<!--@gvkit:if deployDocker-->
PUBLIC_APP_URL=http://localhost:3000
<!--@gvkit:else-->
PUBLIC_APP_URL=http://localhost:5173
<!--@gvkit:endif-->

<!--@gvkit:if monitoringUmami-->
# Umami (both values are required to enable the script)
PUBLIC_UMAMI_HOST=
PUBLIC_UMAMI_WEBSITE_ID=
<!--@gvkit:endif-->
<!--@gvkit:if monitoringPosthog-->
# PostHog public client configuration
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
<!--@gvkit:endif-->
