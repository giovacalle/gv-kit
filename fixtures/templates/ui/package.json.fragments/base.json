{
	"name": "@repo/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts"
		},
		"./utils": {
			"types": "./src/lib/utils.ts",
			"svelte": "./src/lib/utils.ts"
		},
		"./styles": "./src/lib/styles/app.css",
		"./primitives/*": {
			"types": "./src/lib/components/primitives/*/index.ts",
			"svelte": "./src/lib/components/primitives/*/index.ts"
		},
		"./components/*": {
			"types": "./src/lib/components/*/index.ts",
			"svelte": "./src/lib/components/*/index.ts"
		}
	},
	"scripts": {
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@lucide/svelte": "^1.14.0",
		"bits-ui": "^2.16.0",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.0",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.1.0",
		"sveltekit-superforms": "^2.30.0",
		"tailwind-merge": "^2.5.0",
		"tailwind-variants": "^3.2.0",
		"tailwindcss": "^4.2.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@repo/tooling-typescript": "workspace:*",
		"svelte": "^5.55.0",
		"svelte-check": "^4.4.0",
		"typescript": "~5.9.0"
	}
}
