{
	// SvelteKit + Cloudflare adapter on Workers.
	// JSONC: comments and trailing $schema are honored by wrangler.
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "__PROJECT__-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "__COMPAT_DATE__",
	"compatibility_flags": ["nodejs_compat"],
	// Replace <domain> with the project's apex domain.
	"routes": [
		/*@gvkit:if marketingAstro*/
		{ "pattern": "app.<domain>", "custom_domain": true }
		/*@gvkit:endif*/
		/*@gvkit:if insideWeb*/
		{ "pattern": "<domain>", "custom_domain": true }
		/*@gvkit:endif*/
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
	/*@gvkit:if honoAuth*/
	,"services": [
		{ "binding": "AUTH", "service": "__PROJECT__-auth" }
	]
	/*@gvkit:endif*/
}
