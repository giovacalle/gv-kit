{
	"name": "gv-kit",
	"version": "0.1.0",
	"description": "Scaffolding CLI for Turborepo monorepos (SvelteKit + Hono on CF Workers)",
	"license": "MIT",
	"author": "giovacalle",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/giovacalle/gv-kit.git"
	},
	"homepage": "https://github.com/giovacalle/gv-kit#readme",
	"bugs": "https://github.com/giovacalle/gv-kit/issues",
	"keywords": [
		"scaffolding",
		"cli",
		"turborepo",
		"sveltekit",
		"hono",
		"cloudflare-workers",
		"monorepo"
	],
	"type": "module",
	"main": "./dist/cli.js",
	"bin": {
		"gv-kit": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=20"
	},
	"scripts": {
		"dev": "bun run src/cli.ts",
		"bundle:templates": "bun run scripts/bundle-templates.ts",
		"prebuild": "bun run bundle:templates",
		"build": "bun build src/cli.ts --target=node --outfile=dist/cli.js --banner='#!/usr/bin/env node' && chmod +x dist/cli.js",
		"pretest": "bun run bundle:templates",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"verify:astro-matrix": "bun run scripts/verify-astro-scaffold-matrix.ts",
		"snap": "bun run bundle:templates && UPDATE_SNAPSHOTS=1 bun test tests/pipeline.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests",
		"format": "prettier --write \"src/**/*.{ts,json,md}\" \"tests/**/*.ts\"",
		"release": "bun run build && changeset publish"
	},
	"dependencies": {
		"@clack/prompts": "^1.2.0",
		"zod": "^4.3.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@types/bun": "latest",
		"@types/node": "^20.0.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.4.0",
		"eslint": "^9.0.0",
		"@eslint/js": "^9.0.0",
		"typescript-eslint": "^8.0.0",
		"prettier": "^3.4.0",
		"typescript": "~5.9.0"
	},
	"overrides": {
		"zod": "^4.3.0"
	}
}
