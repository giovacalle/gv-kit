{
	"scripts": {
		"cf-typegen": "wrangler types --include-runtime=false && rm -f worker-configuration.bootstrap.d.ts",
		"build": "vite build",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy:production": "pnpm cf-typegen && wrangler deploy",
		"deploy:staging": "pnpm cf-typegen && node ../../scripts/deploy-cloudflare-staging.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260825.1",
		"wrangler": "^4.125.0"
	}
}
